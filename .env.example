# FrameForge Studio - configuration template. Copy to `.env` (never commit `.env`).
# Every value here is a placeholder; nothing in this repository contains a real credential.

# --- Local rendering (all optional; auto-detected when unset) -------------------------------
# Absolute path to ffmpeg / ffprobe if they are not on PATH.
FRAMEFORGE_FFMPEG=
FRAMEFORGE_FFPROBE=
# Absolute path to Chromium, Chrome or Edge if it is not auto-detected.
FRAMEFORGE_CHROMIUM=

# --- Web build ------------------------------------------------------------------------------
# Base path for static hosting, e.g. /FrameForge-Studio/ on GitHub Pages. Defaults to ./
VITE_BASE=

# --- Optional Google Apps Script cloud backend ---------------------------------------------
# These are NOT read by the app. They document the values you set as *Script Properties* in the
# Apps Script project (see docs/APPS_SCRIPT.md). Never put them in frontend code.
# GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# SYNC_ENABLED=true
